  description        String?
  type               SurveyType   @default(PULSE)
  status             SurveyStatus @default(DRAFT)
  targetDepartmentId String?
  startDate          DateTime?
  endDate            DateTime?
  eNpsScore          Float?       @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("engagement_surveys")
}

model SurveyQuestion {
  id           String           @id @default(uuid())
  surveyId     String
  survey       EngagementSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questionText String
  type         QuestionType     @default(RATING_1_5)
  options      Json?
  orderIndex   Int              @default(1)
  isRequired   Boolean          @default(true)
  createdAt    DateTime         @default(now())

  @@index([surveyId])
  @@map("survey_questions")
}

model SurveyResponse {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  surveyId       String
  survey         EngagementSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employeeId     String?
  answers        Json
  score          Float?           @default(0)
  submittedAt    DateTime         @default(now())

  @@index([organizationId])
  @@index([surveyId])
  @@map("survey_responses")
}

model AnonymousFeedback {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       String         @default("General Suggestion")
  message        String
  status         FeedbackStatus @default(PENDING)
  responseNote   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@map("anonymous_feedbacks")
}

// Phase 13: Employee Self-Service (ESS) & Manager Self-Service (MSS) Entities
enum DelegationStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model ManagerDelegation {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId      String
  manager        Employee         @relation("ManagerDelegations", fields: [managerId], references: [id], onDelete: Cascade)
  delegateId     String
  delegate       Employee         @relation("DelegateDelegations", fields: [delegateId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  status         DelegationStatus @default(ACTIVE)
  reason         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([managerId])
  @@map("manager_delegations")
}

model OneOnOneMeeting {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId      String
  manager        Employee      @relation("ManagerMeetings", fields: [managerId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation("EmployeeMeetings", fields: [employeeId], references: [id], onDelete: Cascade)
  title          String
  scheduledAt    DateTime
  status         MeetingStatus @default(SCHEDULED)
  agenda         String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([managerId])
  @@index([employeeId])
  @@map("one_on_one_meetings")
}

// Phase 14: IT Logistics & Corporate Asset Management Entities
enum AssetCategory {
  LAPTOP
  DESKTOP
  MOBILE_DEVICE
  MONITOR
  SOFTWARE_LICENSE
  PERIPHERAL
  OTHER
}

enum AssetCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  REPAIR_REQUIRED
  DECOMMISSIONED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  RETIRED
  LOST
}

enum AssetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

model CompanyAsset {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  assetTag       String
  serialNumber   String?
  category       AssetCategory  @default(LAPTOP)
  condition      AssetCondition @default(GOOD)
  status         AssetStatus    @default(AVAILABLE)
  purchaseDate   DateTime?
  purchaseCost   Float?         @default(0)
  warrantyExpiry DateTime?
  assignedToId   String?
  assignedTo     Employee?      @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedDate   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  histories AssetAssignmentHistory[]
  requests  AssetRequest[]

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@index([assignedToId])
  @@map("company_assets")
}

model AssetAssignmentHistory {
  id                String          @id @default(uuid())
  assetId           String
  asset             CompanyAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedDate      DateTime        @default(now())
  returnedDate      DateTime?
  conditionOnReturn AssetCondition?
  notes             String?
  createdAt         DateTime        @default(now())

  @@index([assetId])
  @@index([employeeId])
  @@map("asset_assignment_histories")
}

model AssetRequest {
  id               String             @id @default(uuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById    String
  requestedBy      Employee           @relation("RequestedAssets", fields: [requestedById], references: [id], onDelete: Cascade)
  category         AssetCategory      @default(LAPTOP)
  reason           String
  status           AssetRequestStatus @default(PENDING)
  fulfilledAssetId String?
  fulfilledAsset   CompanyAsset?      @relation(fields: [fulfilledAssetId], references: [id], onDelete: SetNull)
  requestedAt      DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([organizationId])
  @@index([requestedById])
  @@map("asset_requests")
}

// Phase 15: Expense Management & Financial Claims Workflow Entities
enum ExpenseCategory {
  TRAVEL
  MEALS_ENTERTAINMENT
  SUPPLIES
  TRAINING_CERTIFICATION
  UTILITIES
  OTHER
}

enum ExpenseStatus {
  SUBMITTED
  MANAGER_APPROVED
  FINANCE_APPROVED
  DISBURSED
  REJECTED
}

model ExpenseClaim {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimNumber    String
  employeeId     String
  employee       Employee        @relation("EmployeeExpenseClaims", fields: [employeeId], references: [id], onDelete: Cascade)
  category       ExpenseCategory @default(SUPPLIES)
  title          String
  amount         Float
  currency       String          @default("NGN")
  receiptUrl     String?
  description    String?
  status         ExpenseStatus   @default(SUBMITTED)
  managerNotes   String?
  financeNotes   String?
  disbursedAt    DateTime?
  submittedAt    DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, claimNumber])
  @@index([organizationId])
  @@index([employeeId])
  @@map("expense_claims")
}

// Phase 16: Compliance, Policy Documents & Health & Safety (HSE) Entities
enum PolicyCategory {
  CODE_OF_CONDUCT
  IT_SECURITY
  WORKPLACE_HEALTH_SAFETY
  LEAVE_COMPLIANCE
  GENERAL
}

enum IncidentSeverity {
  MINOR
  MODERATE
  SEVERE
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

model CompanyPolicy {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  code           String
  category       PolicyCategory @default(GENERAL)
  documentUrl    String?
  version        String         @default("1.0")
  isMandatory    Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  acknowledgments PolicyAcknowledgment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("company_policies")
}

model PolicyAcknowledgment {
  id             String        @id @default(uuid())
  policyId       String
  policy         CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime      @default(now())
  signatureUrl   String?

  @@unique([policyId, employeeId])
  @@index([employeeId])
  @@map("policy_acknowledgments")
}

model HseIncident {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incidentNumber String
  reportedById   String
  reportedBy     Employee         @relation("ReportedHseIncidents", fields: [reportedById], references: [id], onDelete: Cascade)
  title          String
  location       String?
  severity       IncidentSeverity @default(MINOR)
  status         IncidentStatus   @default(REPORTED)
  description    String
  reportedAt     DateTime         @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, incidentNumber])
  @@index([organizationId])
  @@index([reportedById])
  @@map("hse_incidents")
}






