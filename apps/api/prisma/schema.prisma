// Prisma Schema for Multi-Tenant HR Management & HCM SaaS Platform (Phase 4 - Employee Management)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_ADMIN
  BILLING_ADMIN
  PLATFORM_ANALYST
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum EmployeeStatus {
  PROBATION
  ACTIVE
  SUSPENDED
  TERMINATED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

// Platform Level Entities
model PlatformUser {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  role         PlatformRole @default(PLATFORM_ADMIN)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("platform_users")
}

model Organization {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  domain       String?            @unique
  logoUrl      String?
  industry     String?
  country      String             @default("Nigeria")
  currency     String             @default("NGN")
  timezone     String             @default("Africa/Lagos")
  address      String?
  city         String?
  state        String?
  zipCode      String?
  phone        String?
  email        String?
  website      String?
  status       OrganizationStatus @default(ACTIVE)
  maxEmployees Int                @default(50)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  users             User[]
  roles             Role[]
  branches          Branch[]
  departments       Department[]
  teams             Team[]
  locations         Location[]
  jobPositions      JobPosition[]
  jobGrades         JobGrade[]
  employmentTypes   EmploymentType[]
  workSchedules     WorkSchedule[]
  holidays          HolidayCalendar[]
  employees         Employee[]
  employeeDocuments EmployeeDocument[]
  employeeHistories EmployeeHistory[]
  auditLogs         AuditLog[]
  sessions          Session[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  country        String       @default("Nigeria")
  phone          String?
  email          String?
  isHeadquarters Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Department {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  code               String
  description        String?
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  subDepartments     Department[] @relation("DepartmentHierarchy")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  teams        Team[]
  jobPositions JobPosition[]
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees Employee[]

  @@index([organizationId])
  @@index([departmentId])
  @@map("teams")
}

model Location {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  address        String
  city           String
  state          String?
  country        String       @default("Nigeria")
  timezone       String       @default("Africa/Lagos")
  latitude       Float?
  longitude      Float?
  radiusMeters   Int          @default(100)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("locations")
}

model JobGrade {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  level          Int          @default(1)
  minSalary      Float?
  maxSalary      Float?
  currency       String       @default("NGN")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobPositions JobPosition[]
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("job_grades")
}

model JobPosition {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  jobGradeId     String?
  jobGrade       JobGrade?    @relation(fields: [jobGradeId], references: [id], onDelete: SetNull)
  title          String
  code           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@map("job_positions")
}

model EmploymentType {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  isContract     Boolean      @default(false)
  createdAt      DateTime     @default(now())

  employees Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("employment_types")
}

model WorkSchedule {
  id                   String       @id @default(uuid())
  organizationId       String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  workDays             String[]
  startTime            String       @default("08:00")
  endTime              String       @default("17:00")
  breakDurationMinutes Int          @default(60)
  isDefault            Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  employees Employee[]

  @@index([organizationId])
  @@map("work_schedules")
}

model HolidayCalendar {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  date           DateTime
  isRecurring    Boolean      @default(true)
  description    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("holiday_calendars")
}

// Phase 4: Employee Entities
model Employee {
  id                   String          @id @default(uuid())
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId               String?         @unique
  user                 User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeCode         String
  firstName            String
  lastName             String
  middleName           String?
  email                String
  phone                String?
  photoUrl             String?
  dateOfBirth          DateTime?
  gender               Gender?
  maritalStatus        MaritalStatus?
  nationalId           String?
  address              String?
  city                 String?
  state                String?
  country              String          @default("Nigeria")
  
  // Placements
  branchId             String?
  branch               Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId         String?
  department           Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId               String?
  team                 Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  positionId           String?
  position             JobPosition?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  jobGradeId           String?
  jobGrade             JobGrade?       @relation(fields: [jobGradeId], references: [id], onDelete: SetNull)
  locationId           String?
  location             Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  employmentTypeId     String?
  employmentType       EmploymentType? @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  workScheduleId       String?
  workSchedule         WorkSchedule?   @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  managerId            String?
  manager              Employee?       @relation("EmployeeReporting", fields: [managerId], references: [id], onDelete: SetNull)
  directReports        Employee[]      @relation("EmployeeReporting")

  // Dates & Status
  hireDate             DateTime
  confirmationDate     DateTime?
  probationEndDate     DateTime?
  status               EmployeeStatus  @default(PROBATION)

  // Financial & Bank Details
  basicSalary          Float           @default(0)
  bankName             String?
  accountNumber        String?
  bankCode             String?
  taxId                String?
  pfaName              String?
  rsaNumber            String?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  emergencyContacts    EmergencyContact[]
  documents            EmployeeDocument[]
  histories            EmployeeHistory[]
  statusHistories      EmployeeStatusHistory[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([departmentId])
  @@index([branchId])
  @@index([status])
  @@map("employees")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?
  address      String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@map("emergency_contacts")
}

model EmployeeDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title          String
  category       String       // e.g. Contract, Certificate, ID, Passport, Tax
  fileUrl        String
  fileType       String?
  fileSize       Int?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([employeeId])
  @@map("employee_documents")
}

model EmployeeHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  eventType      String       // e.g. HIRE, PROMOTION, SALARY_UPDATE, DEPT_TRANSFER, STATUS_CHANGE
  description    String
  previousData   Json?
  newData        Json?
  effectiveDate  DateTime     @default(now())
  createdByUserId String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([employeeId])
  @@map("employee_histories")
}

model EmployeeStatusHistory {
  id             String         @id @default(uuid())
  organizationId String
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  previousStatus EmployeeStatus
  newStatus      EmployeeStatus
  reason         String?
  effectiveDate  DateTime       @default(now())
  createdAt      DateTime       @default(now())

  @@index([employeeId])
  @@map("employee_status_histories")
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isSystemRole   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  permissions RolePermission[]
  users       User[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String     @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId              String?
  role                Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  email               String
  passwordHash        String
  firstName           String
  lastName            String
  phoneNumber         String?
  status              UserStatus @default(PENDING)
  avatarUrl           String?
  isEmailVerified     Boolean    @default(false)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  employee                Employee?
  auditLogs               AuditLog[]
  sessions                Session[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  mfaConfiguration        MFAConfiguration?

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Session {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String       @unique
  ipAddress      String?
  userAgent      String?
  isRevoked      Boolean      @default(false)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organizationId])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model MFAConfiguration {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEnabled Boolean  @default(false)
  secret    String?
  type      String   @default("TOTP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mfa_configurations")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String?
  previousState  Json?
  newState       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("audit_logs")
}

model SystemHealth {
  id        String   @id @default(uuid())
  service   String
  status    String
  details   Json?
  createdAt DateTime @default(now())

  @@map("system_health")
}
