// Prisma Schema for Multi-Tenant HR Management & HCM SaaS Platform (Phase 6 - Recruitment & Onboarding)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_ADMIN
  BILLING_ADMIN
  PLATFORM_ANALYST
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum EmployeeStatus {
  PROBATION
  ACTIVE
  SUSPENDED
  TERMINATED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_DEPARTURE
  ABSENT
  ON_LEAVE
  HALF_DAY
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  ASSESSMENT
  OFFER
  HIRED
  REJECTED
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum CalculationType {
  FIXED
  PERCENTAGE_OF_BASIC
}

enum PayrollFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  APPROVED
  DISBURSED
}

enum BenefitType {
  HEALTH_INSURANCE
  DENTAL
  VISION
  LIFE_INSURANCE
  RETIREMENT_SAVINGS
  WELLNESS
  MEAL_VOUCHER
  TRANSPORT
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CompensationReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_TRACK
  AT_RISK
  COMPLETED
}

enum GoalCategory {
  INDIVIDUAL
  DEPARTMENTAL
  ORGANIZATIONAL
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  EVALUATION_PERIOD
  CLOSED
}

enum EvaluationStatus {
  SELF_EVALUATION_PENDING
  MANAGER_EVALUATION_PENDING
  COMPLETED
}

enum CourseType {
  INTERNAL_WORKSHOP
  EXTERNAL_CERTIFICATION
  ONLINE_SELF_PACED
  MANDATORY_COMPLIANCE
}

enum TrainingEnrollmentStatus {
  REQUESTED
  ENROLLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
  MASTER
}

// Platform Level Entities
model PlatformUser {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  role         PlatformRole @default(PLATFORM_ADMIN)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("platform_users")
}

model Organization {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  domain       String?            @unique
  logoUrl      String?
  industry     String?
  country      String             @default("Nigeria")
  currency     String             @default("NGN")
  timezone     String             @default("Africa/Lagos")
  address      String?
  city         String?
  state        String?
  zipCode      String?
  phone        String?
  email        String?
  website      String?
  status       OrganizationStatus @default(ACTIVE)
  maxEmployees Int                @default(50)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  users                     User[]
  roles                     Role[]
  branches                  Branch[]
  departments               Department[]
  teams                     Team[]
  locations                 Location[]
  jobPositions              JobPosition[]
  jobGrades                 JobGrade[]
  employmentTypes           EmploymentType[]
  workSchedules             WorkSchedule[]
  holidays                  HolidayCalendar[]
  employees                 Employee[]
  attendanceRecords         AttendanceRecord[]
  overtimeRecords           OvertimeRecord[]
  attendanceCorrections     AttendanceCorrection[]
  leaveTypes                LeaveType[]
  leavePolicies             LeavePolicy[]
  leaveBalances             LeaveBalance[]
  leaveRequests             LeaveRequest[]
  jobPostings               JobPosting[]
  candidates                Candidate[]
  jobApplications           JobApplication[]
  interviews                Interview[]
  jobOffers                 JobOffer[]
  onboardingTemplates       OnboardingTemplate[]
  employeeOnboardingProcesses EmployeeOnboardingProcess[]
  salaryComponents          SalaryComponent[]
  salaryStructures          SalaryStructure[]
  payrollPeriods            PayrollPeriod[]
  payrollRuns               PayrollRun[]
  benefitPlans              BenefitPlan[]
  employeeBenefitEnrollments EmployeeBenefitEnrollment[]
  compensationReviews       CompensationReview[]
  bonusAllocations          BonusAllocation[]
  goals                     Goal[]
  performanceReviewCycles   PerformanceReviewCycle[]
  performanceReviews        PerformanceReview[]
  trainingCourses           TrainingCourse[]
  trainingEnrollments       TrainingEnrollment[]
  skills                    Skill[]
  careerPaths               CareerPath[]
  successionPlans           SuccessionPlan[]
  mobilityRequests          InternalMobilityRequest[]
  surveys                   EngagementSurvey[]
  surveyResponses           SurveyResponse[]
  anonymousFeedbacks        AnonymousFeedback[]
  managerDelegations        ManagerDelegation[]
  oneOnOneMeetings          OneOnOneMeeting[]
  companyAssets             CompanyAsset[]
  assetRequests             AssetRequest[]
  expenseClaims             ExpenseClaim[]
  companyPolicies           CompanyPolicy[]
  hseIncidents               HseIncident[]
  employeeDocuments         EmployeeDocument[]
  employeeHistories         EmployeeHistory[]
  auditLogs                 AuditLog[]
  sessions                  Session[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  country        String       @default("Nigeria")
  phone          String?
  email          String?
  isHeadquarters Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Department {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  code               String
  description        String?
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  subDepartments     Department[] @relation("DepartmentHierarchy")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  teams        Team[]
  jobPositions JobPosition[]
  employees    Employee[]
  jobPostings  JobPosting[]
  careerPaths  CareerPath[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees Employee[]

  @@index([organizationId])
  @@index([departmentId])
  @@map("teams")
}

model Location {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  address        String
  city           String
  state          String?
  country        String       @default("Nigeria")
  timezone       String       @default("Africa/Lagos")
  latitude       Float?
  longitude      Float?
  radiusMeters   Int          @default(100)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees   Employee[]
  jobPostings JobPosting[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("locations")
}

model JobGrade {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  level          Int          @default(1)
  minSalary      Float?
  maxSalary      Float?
  currency       String       @default("NGN")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobPositions JobPosition[]
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("job_grades")
}

model JobPosition {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  jobGradeId     String?
  jobGrade       JobGrade?    @relation(fields: [jobGradeId], references: [id], onDelete: SetNull)
  title          String
  code           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees         Employee[]
  skillRequirements SkillRequirement[]
  successionPlans   SuccessionPlan[]
  mobilityRequests  InternalMobilityRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@map("job_positions")
}

model EmploymentType {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  isContract     Boolean      @default(false)
  createdAt      DateTime     @default(now())

  employees     Employee[]
  leavePolicies LeavePolicy[]
  jobPostings   JobPosting[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("employment_types")
}

model WorkSchedule {
  id                   String       @id @default(uuid())
  organizationId       String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  workDays             String[]
  startTime            String       @default("08:00")
  endTime              String       @default("17:00")
  breakDurationMinutes Int          @default(60)
  isDefault            Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  employees Employee[]

  @@index([organizationId])
  @@map("work_schedules")
}

model HolidayCalendar {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  date           DateTime
  isRecurring    Boolean      @default(true)
  description    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("holiday_calendars")
}

model Employee {
  id                   String          @id @default(uuid())
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId               String?         @unique
  user                 User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeCode         String
  firstName            String
  lastName             String
  middleName           String?
  email                String
  phone                String?
  photoUrl             String?
  dateOfBirth          DateTime?
  gender               Gender?
  maritalStatus        MaritalStatus?
  nationalId           String?
  address              String?
  city                 String?
  state                String?
  country              String          @default("Nigeria")
  
  branchId             String?
  branch               Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId         String?
  department           Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId               String?
  team                 Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  positionId           String?
  position             JobPosition?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  jobGradeId           String?
  jobGrade             JobGrade?       @relation(fields: [jobGradeId], references: [id], onDelete: SetNull)
  locationId           String?
  location             Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  employmentTypeId     String?
  employmentType       EmploymentType? @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  workScheduleId       String?
  workSchedule         WorkSchedule?   @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  managerId            String?
  manager              Employee?       @relation("EmployeeReporting", fields: [managerId], references: [id], onDelete: SetNull)
  directReports        Employee[]      @relation("EmployeeReporting")

  hireDate             DateTime
  confirmationDate     DateTime?
  probationEndDate     DateTime?
  status               EmployeeStatus  @default(PROBATION)

  basicSalary          Float           @default(0)
  bankName             String?
  accountNumber        String?
  bankCode             String?
  taxId                String?
  pfaName              String?
  rsaNumber            String?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  emergencyContacts     EmergencyContact[]
  documents             EmployeeDocument[]
  histories             EmployeeHistory[]
  statusHistories       EmployeeStatusHistory[]
  attendanceRecords     AttendanceRecord[]
  overtimeRecords       OvertimeRecord[]
  attendanceCorrections AttendanceCorrection[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  onboardingProcesses   EmployeeOnboardingProcess[]
  salaryAssignments     EmployeeSalaryAssignment[]
  payrollEntries        PayrollEntry[]
  benefitEnrollments    EmployeeBenefitEnrollment[]
  compensationReviews   CompensationReview[]
  bonusAllocations      BonusAllocation[]
  goals                 Goal[]
  performanceReviews    PerformanceReview[] @relation("EmployeeReviews")
  reviewerEvaluations   PerformanceReview[] @relation("ReviewerEvaluations")
  trainingEnrollments   TrainingEnrollment[]
  skills                EmployeeSkill[]
  successionCandidates  SuccessionCandidate[]
  mobilityRequests      InternalMobilityRequest[] @relation("EmployeeMobilityRequests")
  givenDelegations      ManagerDelegation[] @relation("ManagerDelegations")
  receivedDelegations   ManagerDelegation[] @relation("DelegateDelegations")
  managerMeetings       OneOnOneMeeting[] @relation("ManagerMeetings")
  employeeMeetings      OneOnOneMeeting[] @relation("EmployeeMeetings")
  assignedAssets        CompanyAsset[]
  assetAssignmentHistories AssetAssignmentHistory[]
  requestedAssets       AssetRequest[] @relation("RequestedAssets")
  expenseClaims         ExpenseClaim[] @relation("EmployeeExpenseClaims")
  policyAcknowledgments PolicyAcknowledgment[]
  reportedHseIncidents  HseIncident[] @relation("ReportedHseIncidents")

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([departmentId])
  @@index([branchId])
  @@index([status])
  @@map("employees")
}

// Phase 6: Recruitment / ATS Entities
model JobPosting {
  id               String          @id @default(uuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title            String
  code             String
  departmentId     String?
  department       Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId       String?
  location         Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  employmentTypeId String?
  employmentType   EmploymentType? @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  minSalary        Float?
  maxSalary        Float?
  description      String
  requirements     String?
  status           JobStatus       @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  applications JobApplication[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("job_postings")
}

model Candidate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String
  phone          String?
  resumeUrl      String?
  skills         String[]
  source         String?      @default("Direct Application")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  applications JobApplication[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("candidates")
}

model JobApplication {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobPostingId   String
  jobPosting     JobPosting       @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage          ApplicationStage @default(APPLIED)
  rating         Int?             @default(0)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  interviews Interview[]
  offers     JobOffer[]

  @@unique([jobPostingId, candidateId])
  @@index([organizationId])
  @@index([stage])
  @@map("job_applications")
}

model Interview {
  id               String         @id @default(uuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  title            String
  scheduledAt      DateTime
  location         String?
  interviewerName  String?
  feedback         String?
  rating           Int?           @default(0)
  createdAt        DateTime       @default(now())

  @@index([organizationId])
  @@index([jobApplicationId])
  @@map("interviews")
}

model JobOffer {
  id               String         @id @default(uuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  offeredSalary    Float
  startDate        DateTime
  status           OfferStatus    @default(DRAFT)
  offerLetterUrl   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([organizationId])
  @@index([jobApplicationId])
  @@map("job_offers")
}

// Phase 6: Onboarding Entities
model OnboardingTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tasks               OnboardingTask[]
  onboardingProcesses EmployeeOnboardingProcess[]

  @@index([organizationId])
  @@map("onboarding_templates")
}

model OnboardingTask {
  id          String             @id @default(uuid())
  templateId  String
  template    OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isRequired  Boolean            @default(true)
  dueDays     Int                @default(7)
  createdAt   DateTime           @default(now())

  @@index([templateId])
  @@map("onboarding_tasks")
}

model EmployeeOnboardingProcess {
  id                 String             @id @default(uuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId         String?
  template           OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  progressPercentage Float              @default(0)
  isCompleted        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tasks EmployeeOnboardingTask[]

  @@index([organizationId])
  @@index([employeeId])
  @@map("employee_onboarding_processes")
}

model EmployeeOnboardingTask {
  id          String                    @id @default(uuid())
  processId   String
  process     EmployeeOnboardingProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isRequired  Boolean                   @default(true)
  status      TaskStatus                @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime                  @default(now())

  @@index([processId])
  @@map("employee_onboarding_tasks")
}

// Phase 5: Attendance & Leave Entities
model AttendanceRecord {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime
  clockIn        DateTime
  clockOut       DateTime?
  totalHours     Float            @default(0)
  breakMinutes   Int              @default(60)
  status         AttendanceStatus @default(PRESENT)
  ipAddress      String?
  userAgent      String?
  latitude       Float?
  longitude      Float?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  corrections AttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([organizationId])
  @@index([employeeId])
  @@index([date])
  @@map("attendance_records")
}

model OvertimeRecord {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime
  hours          Float
  reason         String?
  isApproved     Boolean      @default(false)
  approvedByUserId String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([employeeId])
  @@map("overtime_records")
}

model AttendanceCorrection {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceRecordId String?
  attendanceRecord   AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  requestedClockIn   DateTime
  requestedClockOut  DateTime
  reason             String
  status             CorrectionStatus @default(PENDING)
  reviewedByUserId   String?
  reviewNotes        String?
  createdAt          DateTime         @default(now())

  @@index([organizationId])
  @@index([employeeId])
  @@map("attendance_corrections")
}

model LeaveType {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  code             String
  defaultDays      Int          @default(20)
  isPaid           Boolean      @default(true)
  requiresApproval Boolean      @default(true)
  colorCode        String?      @default("#3B82F6")
  createdAt        DateTime     @default(now())

  policies      LeavePolicy[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("leave_types")
}

model LeavePolicy {
  id                 String          @id @default(uuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveTypeId        String
  leaveType          LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  employmentTypeId   String?
  employmentType     EmploymentType? @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  maxDaysPerYear     Int             @default(20)
  carryOverDays      Int             @default(5)
  noticeDaysRequired Int             @default(3)
  createdAt          DateTime        @default(now())

  @@index([organizationId])
  @@map("leave_policies")
}

model LeaveBalance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year           Int
  totalDays      Float        @default(20)
  usedDays       Float        @default(0)
  pendingDays    Float        @default(0)
  remainingDays  Float        @default(20)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([organizationId])
  @@index([employeeId])
  @@map("leave_balances")
}

model LeaveRequest {
